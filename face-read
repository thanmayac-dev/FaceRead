import cv2 as cv
from fer import FER
cap=cv.VideoCapture(0)
haar_cascade=cv.CascadeClassifier('haar_face.xml')
detector=FER()
emotion_colors={
    'happy':(0,255,0),
    'sad':(255,0,0),
    'angry':(0,0,255),
    'neutral':(255,255,255),
    'fear':(0,255,255),
    'surprise':(255,165,0),
    'disgust':(128,0,128)
}
while True:
    isTrue,frame=cap.read()
    vdo=cv.flip(frame,1)
    face_rect=haar_cascade.detectMultiScale(vdo,scaleFactor=1.1,minNeighbors=3)
    for (x,y,w,h) in face_rect:
        face_crop=vdo[y:y+h,x:x+w]
        result=detector.detect_emotions(face_crop)
        if result:
            emotions=result[0]['emotions']
            dominant=max(emotions,key=emotions.get)
            print(dominant)
            color=emotion_colors.get(dominant,(0,255,0))
            cv.rectangle(vdo,(x,y),(x+w,y+h),color,2)
            cv.putText(vdo,f'{dominant.upper()}',(x,y-10),cv.FONT_HERSHEY_TRIPLEX,1.0,color,2)
    cv.imshow('video',vdo)
    if cv.waitKey(1) & 0xFF==ord('q'):
        break
cap.release()
cv.destroyAllWindows()
